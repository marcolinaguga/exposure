# ---------------------------------------------------------------------------
# MODELO de variáveis de ambiente.
# 1. Copie este arquivo para ".env" (sem o ".example").
# 2. Preencha os valores reais.
# 3. NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).
# Na Vercel, cadastre estas mesmas variáveis em:
#   Project > Settings > Environment Variables
# ---------------------------------------------------------------------------

# URL do seu projeto Supabase (Project Settings > API > Project URL).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" (Project Settings > API > service_role / secret key).
# ATENÇÃO: esta chave ignora todas as regras de segurança do banco.
# Ela só pode existir no BACKEND. Nunca coloque no JavaScript do navegador.
SUPABASE_SERVICE_KEY=cole-aqui-a-chave-service-role

# Nome do bucket do Storage criado pelo script supabase/schema.sql.
STORAGE_BUCKET=photos

# Senha que VOCÊ digitará na página de login para enviar fotos.
# Use uma senha longa (12+ caracteres).
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Chave secreta usada para assinar os tokens de login.
# Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cole-aqui-uma-chave-aleatoria-longa

# Opcional: por quantas horas o login continua válido (padrão: 168 = 7 dias).
TOKEN_EXPIRE_HOURS=168

# Opcional: por quantos segundos os links das imagens privadas valem
# (padrão: 3600 = 1 hora).
SIGNED_URL_EXPIRE_SECONDS=3600
